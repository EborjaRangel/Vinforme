# Clave del control de acceso. Cámbiala antes de publicar el sitio.
ADMIN_PASSWORD=coyoacan-informe
ADMIN_SECRET=cambia-este-secreto-del-v-informe

# Postgres de Railway. En Vercel usa la URL pública. Dentro de Railway puede ser la URL interna.
# DATABASE_URL=postgresql://usuario:clave@host:puerto/railway

# Dirección pública del sitio, sin diagonal final.
# Si la defines, el QR general, los pases y los mensajes usarán esta URL.
# APP_URL=https://informe.alcaldia.gob.mx

# Correo (SMTP). Ejemplo con Gmail: puerto 587 y una contraseña de aplicación.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="V Informe Coyoacán <tu-correo@gmail.com>"

# WhatsApp con Twilio. El destino se arma como whatsapp:+52 y los 10 dígitos capturados.
# TWILIO_FROM puede ser el número del sandbox o el remitente de WhatsApp, con o sin el prefijo whatsapp:.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=whatsapp:+14155238886
# Plantilla aprobada, opcional. Las variables son {{1}} nombre y {{2}} enlace del pase.
# TWILIO_CONTENT_SID=

# Alternativa a Twilio: un webhook propio que reciba { telefono, mensaje, nombre }.
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
